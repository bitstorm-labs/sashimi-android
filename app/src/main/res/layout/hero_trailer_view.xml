<?xml version="1.0" encoding="utf-8"?>
<!--
    The detail hero's trailer layer. A TextureView rather than the default
    SurfaceView: it composites like any other view inside the scrolling detail
    column, and the surface type can only be chosen in XML. The shutter matches
    the hero's empty background (SashimiCard), so with no player attached this
    layer looks exactly like the hero did before trailers existed.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:importantForAccessibility="noHideDescendants"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="zoom"
    app:show_buffering="never"
    app:use_artwork="false"
    app:shutter_background_color="#FF1F1F24" />
